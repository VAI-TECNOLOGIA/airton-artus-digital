Imagem/
imagens/
id visual*

# Artefatos de teste E2E
frontend/tests/e2e/.auth/
frontend/test-results/
frontend/playwright-report/
.env*

# Capacitor / Android — arquivos sensíveis (NUNCA commitar)
frontend/android/key.properties
frontend/android/app/*.keystore
frontend/android/app/*.jks
frontend/android/app/google-services.json
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/build/
frontend/android/build/
# Assets de origem gerados localmente para a Play Store (regeneráveis)
frontend/play-store-assets/

# Capacitor / iOS
# GoogleService-Info.plist contém as chaves do app iOS no Firebase — NUNCA commitar.
frontend/ios/App/App/GoogleService-Info.plist
# Build artifacts / SPM / Pods / signing (regeneráveis)
frontend/ios/App/build/
frontend/ios/App/Pods/
frontend/ios/App/App.xcworkspace/xcuserdata/
frontend/ios/App/App.xcodeproj/xcuserdata/
frontend/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
frontend/ios/App/CapApp-SPM/.build/
frontend/ios/DerivedData/
frontend/ios/App/ExportOptions.plist
# Assets iOS gerados localmente para a App Store (regeneráveis)
frontend/app-store-assets/
frontend/screenshots/
frontend/video-raw/
# NUNCA commitar chaves/segredos iOS
*.p8
*.p12
*.mobileprovision

# Screenshots crus do manual (contem dados reais) — o manual embute versoes otimizadas
docs/img/
